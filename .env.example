# ==========================================
# REELIO ENVIRONMENT VARIABLES (TEMPLATE)
# ==========================================

# -----------------
# Backend (apps/api)
# -----------------
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reelio?schema=public"

# JWT secret key for signing authentication tokens
JWT_SECRET="your-super-secret-jwt-key-replace-in-production"

# Port for NestJS API server
PORT=4000

# CORS allowed frontend origin
FRONTEND_URL="http://localhost:3000"

# ------------------
# Frontend (apps/web)
# ------------------
# Base URL to access NestJS backend API
NEXT_PUBLIC_API_URL="http://localhost:4000"
